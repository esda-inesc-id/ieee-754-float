import sys
import string
import math
import cmath

# revert bits function
def invert(x): return ~x & 0xffffffff

def generateTimeVector(n, fs):
    # initialize time vector
    t = []
    
    # generate a vector time discretized
    numb = 0.0
    for i in range(n):
	    t.append(numb)
	    numb += 1/fs
	
    return t

def generateInputData(integer, binary, outputDir, n, f, t):
    fw_f = open(outputDir+'x.txt', 'w')
    if (integer): fw = open(outputDir+'x.hex', 'w')
    
    # byte vector
    lst_b = []
    
    # generate pointeger for each time instant
    for i in range(n):
	    # low frequency signal
	    numb_f = math.sin(2*math.pi*f*t[i]) # function to discretize
	    
	    fw_f.write(str(numb_f)+"\n")
	    fw_f.write("0.0\n")
	    
	    if (integer or binary):
	        # take care of overflow/underflow cases (format Q1.31)
	        if(abs(numb_f) < 2**-31): numb_f = 0.0
	        else: numb_f *= 0.999
	        
	        # convert float to hex (string) with two's complement
	        if (numb_f < 0):
		        numb_f = numb_f * -1
		        numb_d = invert(int(round(numb_f*2**31)))+1
	        else:
		        numb_d = int(round(numb_f*2**31))
	        numb_h = "{:08x}".format(numb_d)
	    
	    if (integer):
	        fw.write("0x"+numb_h+", ")
	        fw.write("0x00000000")
	        if (i != (n-1)): fw.write(", ")
	    
	    if (binary):
	        lst_b.append(numb_d&0x000000ff)
	        lst_b.append((numb_d&0x0000ff00)>>8)
	        lst_b.append((numb_d&0x00ff0000)>>16)
	        lst_b.append((numb_d&0xff000000)>>24)
	        
	        lst_b.append(0)
	        lst_b.append(0)
	        lst_b.append(0)
	        lst_b.append(0)
    
    fw_f.close()
    if (integer): fw.close()
    
    if (binary):
        fw = open(outputDir+'x.bin', 'wb')
        fw.write(bytearray(lst_b))
        fw.close()
    
    return

def generateWeights(integer, binary, outputDir, n, f, t):
    fw_f = open(outputDir+'w.txt', 'w')
    if (integer): fw = open(outputDir+'w.hex', 'w')
    
    # byte vector
    lst_b = []
    
    # generate weights
    for i in range(n//2):
	    numb_c = cmath.exp(-1j*2*cmath.pi*i/n)
	    
	    # real part
	    numb_f = numb_c.real
	    
	    fw_f.write(str(numb_f)+"\n")
	    
	    if (integer or binary):
	        # take care of overflow/underflow cases (format Q1.31)
	        if(abs(numb_f) < 2**-31): numb_f = 0.0
	        else: numb_f *= 0.999
	        
	        # convert float to hex (string) with two's complement
	        if (numb_f < 0):
		        numb_f = numb_f * -1
		        numb_d = invert(int(round(numb_f*2**31)))+1
	        else:
		        numb_d = int(round(numb_f*2**31))
	        numb_h = "{:08x}".format(numb_d)
	    
	    if (integer): fw.write("0x"+numb_h+", ")
	    
	    if (binary):
	        lst_b.append(numb_d&0x000000ff)
	        lst_b.append((numb_d&0x0000ff00)>>8)
	        lst_b.append((numb_d&0x00ff0000)>>16)
	        lst_b.append((numb_d&0xff000000)>>24)
	    
	    # imaginary part
	    numb_f = numb_c.imag
	    
	    fw_f.write(str(numb_f)+"\n")
	    
	    if (integer or binary):
	        # take care of overflow cases (format Q1.31)
	        if(abs(numb_f) < 2**-31): numb_f = 0.0
	        else: numb_f *= 0.999
	        
	        # convert float to hex (string) with two's complement
	        if (numb_f < 0):
		        numb_f = numb_f * -1
		        numb_d = invert(int(round(numb_f*2**31)))+1
	        else:
		        numb_d = int(round(numb_f*2**31))
	        numb_h = "{:08x}".format(numb_d)
	    
	    if (integer):
	        fw.write("0x"+numb_h)
	        if (i != (n//2-1)): fw.write(", ")
	    
	    if (binary):
	        lst_b.append(numb_d&0x000000ff)
	        lst_b.append((numb_d&0x0000ff00)>>8)
	        lst_b.append((numb_d&0x00ff0000)>>16)
	        lst_b.append((numb_d&0xff000000)>>24)
    
    fw_f.close()
    if (integer): fw.close()
    
    if (binary):
        fw = open(outputDir+'w.bin', 'wb')
        fw.write(bytearray(lst_b))
        fw.close()
    
    return

def run(integer, binary, outputDir, n, fs, f):
    
    t = generateTimeVector(n, fs)
    generateInputData(integer, binary, outputDir, n, f, t)
    generateWeights(integer, binary, outputDir, n, f, t)
    
    return

def usage(message):
    print("usage: %s" % message)
    print("       ./generateInput -i <for integer data> -b <binary data> -o <output directory> -n <number of data pointeger> -fs <sample frequency> -f <input signal frequency>")
    sys.exit(1)

def main():
    
    # Defaults
    integer = 0
    binary = 0
    n = 8192
    fs = 8e3
    f = 82.41
    
    outputDir = "."
    
    i = 1
    while (i < len(sys.argv)) :
        if (sys.argv[i] == "-i") :
            integer = 1
        elif (sys.argv[i] == "-b") :
            binary = 1
        elif (sys.argv[i] == "-o") :
            outputDir = sys.argv[i+1]
            i+=1
        elif (sys.argv[i] == "-n") :
            n = int(sys.argv[i+1])
            i+=1
        elif (sys.argv[i] == "-fs") :
            fs = float(sys.argv[i+1])
            i+=1
        elif (sys.argv[i] == "-f") :
            f = float(sys.argv[i+1])
            i+=1
        else : usage("unexpected argument '%s'" % sys.argv[i])
        i+=1
    
    if (outputDir[-1] != '/'): outputDir += '/'
    
    run(integer, binary, outputDir, n, fs, f)
    
    sys.exit(0)

if __name__ == "__main__" : main()
