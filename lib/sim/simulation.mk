include $(FPU_DIR)/lib/config.mk

INCLUDE+=$(incdir)$(FMAC_DIR)/hw/sim/src

# The run configuration: macros (NAME or NAME=VALUE) written to sim_config.vh in the
# simulation directory, which the testbenches include
SIM_CONFIG=sim_config.vh
INCLUDE+=$(incdir).
VHDR+=$(SIM_CONFIG)
CFG=

ifeq ($(VCD),1)
CFG+=VCD
endif

ifeq ($(STREAMS),1)
TB_TOP=fmac_streams_tb
VSRC+=$(FMAC_DIR)/hw/sim/src/fmac_streams_tb.v
else ifeq ($(FPU_MIX),1)
TB_TOP=fpu_mix_tb
VSRC+=$(FPU_UNIT_DIR)/hw/sim/src/fpu_mix_tb.v
else ifeq ($(TESTFLOAT),1)
TB_TOP=testfloat_tb
VSRC+=$(FPU_DIR)/lib/sim/src/testfloat_tb.v
CFG+=TF_DUT=$(CORE)
TF_RND?=0
CFG+=TF_RND=$(TF_RND)
# divisions are iterative: each one first restarts a dummy division
ifeq ($(TF_OP),div)
CFG+=TF_RESTART
endif
TF_FMT?=f32
TF_DATA_W_f16=16
TF_EXP_W_f16=5
TF_DATA_W_f32=32
TF_EXP_W_f32=8
TF_DATA_W_f64=64
TF_EXP_W_f64=11
TF_DATA_W_f128=128
TF_EXP_W_f128=15
# small formats (exhaustive tests from the C model)
TF_DATA_W_fp4=4
TF_EXP_W_fp4=2
TF_DATA_W_fp6=6
TF_EXP_W_fp6=3
TF_DATA_W_e4m3=8
TF_EXP_W_e4m3=4
TF_DATA_W_e5m2=8
TF_EXP_W_e5m2=5
CFG+=TF_DATA_W=$(TF_DATA_W_$(TF_FMT)) TF_EXP_W=$(TF_EXP_W_$(TF_FMT))
ifeq ($(TF_OP),mulAdd)
CFG+=TF_3OP
endif
# ffma takes the three operands at once
ifeq ($(CORE),ffma)
CFG+=TF_FMA
endif
ifeq ($(CORE),fpu)
TF_FUNCT_add=0
TF_FUNCT_sub=1
TF_FUNCT_mul=2
TF_FUNCT_div=3
CFG+=TF_FPU TF_FUNCT=$(TF_FUNCT_$(TF_OP))
endif
else
TB_TOP=$(CORE)_tb
VSRC+=$(FPU_DIR)/$(CORE)/hw/sim/src/$(CORE)_tb.v
endif

define nl


endef
SIM_CONFIG_TEXT=// generated by the make flow from the run variables; do not edit$(nl)$(subst $(nl) ,$(nl),$(foreach c,$(CFG),`define $(subst =, ,$(c))$(nl)))

# rewritten only when the configuration changes, so a rebuild follows it
$(SIM_CONFIG): FORCE
	$(file >$@.new,$(SIM_CONFIG_TEXT))
	@cmp -s $@.new $@ && rm -f $@.new || mv $@.new $@

FORCE:

.PHONY: FORCE
