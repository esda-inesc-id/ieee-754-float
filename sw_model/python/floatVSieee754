#!/usr/bin/env python3
"""Compares a results file with a binary64 reference file, line by line.

usage: floatVSieee754 -d <reference> (-f <float file> | -ieee754 <model file>)
                      [-o <report>] [-p <digits>] [-dw <data width>] [-ew <exponent width>]
"""

import argparse
import math
import sys

import ieee754


def compare(ref_file, target_file, report, fmt_name, sig_w, digits):
    max_err = max_smape = sum_err = sum_smape = 0.0
    diffs = total = 0

    def base2(value):
        return ieee754.double_base2(value, digits)

    for line_r, line_t in zip(ref_file, target_file):
        ref = float(line_r.split("=")[-1])
        target = float(line_t.split("=")[-1])

        if math.isnan(target) or math.isinf(target):
            shown = "nan" if math.isnan(target) else "inf"
            report.write(f"i = {total}, float64 = {base2(ref)}, {fmt_name} = {shown}, "
                         f"diff = -, diffRel = -, sw = {sig_w}\n")
            diffs += 1
        elif ref != target:
            err = abs(target - ref)
            smape = err / ((abs(target) + abs(ref)) / 2)
            sum_err += err
            sum_smape += smape
            max_err = max(max_err, err)
            max_smape = max(max_smape, smape)
            report.write(f"i = {total}, float64 = {base2(ref)}, {fmt_name} = {base2(target)}, "
                         f"err = {base2(err)}, smape = {base2(smape)}, sw = {sig_w}\n")
            diffs += 1
        total += 1

    mean_err = sum_err / total if total else 0.0
    mean_smape = sum_smape / total if total else 0.0
    report.write(f"maxErr = {base2(max_err)}, sw = {sig_w if diffs else 0}\n")
    report.write(f"maxSmape = {base2(max_smape)}, sw = {sig_w if diffs else 0}\n")
    report.write(f"meanErr = {base2(mean_err)}\n")
    report.write(f"meanSmape = {base2(mean_smape)}\n")
    report.write(f"diffs = {diffs}\n")
    report.write(f"total = {total}\n")
    return total


def main():
    parser = argparse.ArgumentParser(description=__doc__, prefix_chars="-")
    parser.add_argument("-d", required=True, dest="reference")
    parser.add_argument("-f", dest="float_file")
    parser.add_argument("-ieee754", dest="model_file")
    parser.add_argument("-o", dest="output")
    parser.add_argument("-p", dest="digits", type=int, default=8)
    parser.add_argument("-dw", dest="data_w", type=int, default=32)
    parser.add_argument("-ew", dest="exp_w", type=int, default=8)
    args = parser.parse_args()

    if bool(args.float_file) == bool(args.model_file):
        parser.error("give exactly one of -f and -ieee754")
    target = args.float_file or args.model_file
    fmt_name = "float32" if args.float_file else "ieee754"
    sig_w = ieee754.SP_MAN_W if args.float_file else args.data_w - args.exp_w

    with open(args.reference) as ref_file, open(target) as target_file:
        report = open(args.output, "w") if args.output else sys.stdout
        try:
            total = compare(ref_file, target_file, report, fmt_name, sig_w, args.digits)
        finally:
            if args.output:
                report.close()
    return 0 if total else 1


if __name__ == "__main__":
    sys.exit(main())
